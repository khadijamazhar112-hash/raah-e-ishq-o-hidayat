# ============================================================
# Noor (نور) — Environment Configuration Template
# Copy this file to .env and configure your secrets
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=noor_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Content & CDN Configuration
EVERYAYAH_CDN_URL=https://everyayah.com/data
QURAN_TEXT_SOURCE=tanzil.net
TRANSLATION_SOURCE=Fateh_Muhammad_Jalandhry
